ALERT ID 2100
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
    TITLE "Two word reads"
    MESSAGE "Match host NOPs and offset. Four pairs of two MOVE.W instructions; only NOPs between words. One tick between pairs. No timing changes or reset. Await host cue."
    BUTTONS "Cancel" "Read"
END
ALERT ID 2101
ERROR
BEGIN
    TITLE "RAM reference error"
    MESSAGE "Reference CRC failed. No reads allowed."
    BUTTONS "OK"
END
