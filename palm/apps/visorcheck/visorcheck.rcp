FORM ID 1000 AT (0 0 160 160)
NOFRAME
BEGIN
    TITLE "Visor ROM Check 0.6.1"
    BUTTON "Delay: Tick" ID 1009 AT (2 114 100 12)
    BUTTON "Each" ID 1010 AT (106 114 52 12)
    BUTTON "Run" ID 1001 AT (2 128 26 14)
    BUTTON "Pass" ID 1004 AT (30 128 26 14)
    BUTTON "Fail" ID 1005 AT (58 128 26 14)
    BUTTON "Pairs" ID 1011 AT (86 128 34 14)
    BUTTON "Cancel" ID 1002 AT (122 128 36 14)
    BUTTON "ROM64" ID 1008 AT (2 144 38 14)
    BUTTON "Zero" ID 1006 AT (42 144 34 14)
    BUTTON "Ones" ID 1007 AT (78 144 34 14)
    BUTTON "Details" ID 1003 AT (114 144 44 14)
END
ALERT ID 1100
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
    TITLE "CS0 pattern readback"
    MESSAGE "Keep module seated. Match the host's pattern, delay and Each/Burst64 settings before Read. Burst64 checks mapping/removal around each batch; Cancel runs between batches. No wait-state changes or RESET."
    BUTTONS "Cancel" "Read"
END
ALERT ID 1102
ERROR
BEGIN
    TITLE "Timing restore unresolved"
    MESSAGE "Tests blocked. Original slot timing could not be verified restored, or an unfinished timing journal exists. Keep module seated, stop RP with x, record Details timing page, and request recovery instructions."
    BUTTONS "OK"
END
VERSION ID 1 "0.6.1"
FORM ID 2000 AT (0 0 160 160)
NOFRAME
BEGIN
