FORM ID 1000 AT (0 0 160 160)
NOFRAME
BEGIN
    TITLE "Visor ROM Check 0.4.1"
    BUTTON "Run" ID 1001 AT (2 128 36 14)
    BUTTON "Pass" ID 1004 AT (40 128 36 14)
    BUTTON "Fail" ID 1005 AT (78 128 36 14)
    BUTTON "Cancel" ID 1002 AT (116 128 42 14)
    BUTTON "Details" ID 1003 AT (52 144 56 14)
END
ALERT ID 1100
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
    TITLE "Full CS0 readback"
    MESSAGE "Keep module seated. Send b to arm RP, confirm stopped=0, then read the entire test ROM? No writes or RESET."
    BUTTONS "Cancel" "Read"
END
ALERT ID 1102
ERROR
BEGIN
    TITLE "Timing restore unresolved"
    MESSAGE "Tests blocked. Original slot timing could not be verified restored, or an unfinished timing journal exists. Keep module seated, stop RP with x, record Details timing page, and request recovery instructions."
    BUTTONS "OK"
END
VERSION ID 1 "0.4.1"
