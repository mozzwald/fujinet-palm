    BUTTON "Count" ID 2003 AT (2 126 48 14)
    BUTTON "Pattern" ID 2004 AT (54 126 52 14)
    BUTTON "Back" ID 2005 AT (110 126 48 14)
    BUTTON "Run pair" ID 2001 AT (2 144 76 14)
    BUTTON "Cancel" ID 2002 AT (82 144 76 14)
END
ALERT ID 2100
CONFIRMATION
DEFAULTBUTTON 0
BEGIN
    TITLE "Paired ROM data reads"
    MESSAGE "Match host count and offset. Each pair is ONE MOVE.L; one tick separates pairs. No timing changes or reset. Keep module seated. Cancel is available between pairs."
    BUTTONS "Cancel" "Read"
END
